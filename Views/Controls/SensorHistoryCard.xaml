<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaaDebug.Views.Controls.SensorHistoryCard">
    
    <Border BackgroundColor="White"
            Stroke="#775b46"
            StrokeShape="RoundRectangle 16"
            Padding="14">

        <VerticalStackLayout Spacing="12">

            <!-- Cabeçalho: ícone + nome + faixa ideal -->
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">

                <Label Grid.Column="0"
                       x:Name="SensorIconLabel"
                       FontSize="18"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       x:Name="SensorNameLabel"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#2E4A30"
                       VerticalOptions="Center" />

                <Label Grid.Column="2"
                       x:Name="IdealRangeLabel"
                       FontSize="12"
                       TextColor="#2E4A30"
                       VerticalOptions="Center" />
            </Grid>

            <!-- Estatísticas: mín / média / máx -->
            <Grid ColumnDefinitions="*, *, *">

                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                    <Label Text="Mínimo" FontSize="12" TextColor="#2E4A30" HorizontalOptions="Center" />
                    <Label x:Name="MinValueLabel" FontSize="14" FontAttributes="Bold"
                           TextColor="#6FA8DC" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                    <Label Text="Média" FontSize="12" TextColor="#2E4A30" HorizontalOptions="Center" />
                    <Label x:Name="AvgValueLabel" FontSize="14" FontAttributes="Bold"
                           TextColor="#2E7D32" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                    <Label Text="Máximo" FontSize="12" TextColor="#2E4A30" HorizontalOptions="Center" />
                    <Label x:Name="MaxValueLabel" FontSize="14" FontAttributes="Bold"
                           TextColor="#F0A93B" HorizontalOptions="Center" />
                </VerticalStackLayout>

            </Grid>

            <!-- Gráfico de linha (GraphicsView nativo) -->
            <GraphicsView x:Name="HistoryChart"
                          HeightRequest="120" />

            <!-- Legenda do eixo X -->
            <Grid ColumnDefinitions="*, *">
                <Label Grid.Column="0"
                       x:Name="XAxisStartLabel"
                       FontSize="12"
                       TextColor="#2E4A30"
                       HorizontalOptions="Start" />

                <Label Grid.Column="1"
                       Text="Agora"
                       FontSize="12"
                       TextColor="#2E4A30"
                       HorizontalOptions="End" />
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>