<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaaDebug.Views.Auth.PasswordRecoveryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F4"
             Title="PasswordRecoveryPage">
    <Grid RowDefinitions="Auto, Auto, *"
       Padding="24,24,24,24"
       RowSpacing="24">

        

        <Grid Grid.Row="0"
              ColumnDefinitions="48,*,48"
              Padding="0,10">

            <ImageButton Grid.Column="0"
                         Source="go_back.png"
                         BackgroundColor="Transparent"
                         WidthRequest="40"
                         HeightRequest="40"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"
                         Clicked="OnBackClicked"
                         SemanticProperties.Description="Voltar" />

            <Label Grid.Column="1"
                   Margin="0,0,0,0"
                   Text="Recuperar Senha"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"/>

            <!-- Coluna vazia apenas para equilibrar -->
            <BoxView
                    Grid.Column="2"
                    WidthRequest="40"
                    Opacity="0"/>
        </Grid>




        <!-- Indicador de progresso (3 etapas) -->
        <HorizontalStackLayout Grid.Row="1"
                             Spacing="8"
                             HorizontalOptions="Center">

            <BoxView x:Name="StepDot1" HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="#2E7D32" />
            <BoxView x:Name="StepDot2" HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="#D7E5D9" />
            <BoxView x:Name="StepDot3" HeightRequest="8" WidthRequest="32" CornerRadius="4" Color="#D7E5D9" />
        </HorizontalStackLayout>

        <!-- Conteúdo: apenas uma etapa visível por vez -->
        <ScrollView Grid.Row="2">
            <Grid>

                <!-- ETAPA 1: Informar e-mail -->
                <VerticalStackLayout x:Name="EmailStepLayout"
                                     Margin="0,30,0,0"
                                     Spacing="5"
                                     IsVisible="True">

                    <Label  Text="Qual é o seu e-mail?"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#2E7D32" />

                    <Label Text="Enviaremos um código de 6 dígitos para o e-mail cadastrado."
                            FontSize="13"
                            TextColor="#5C715E" />

                    <VerticalStackLayout Spacing="4" Margin="0,30,0,0">
                        <Label Text="E-mail"
                            FontSize="13"
                            TextColor="#775b46"
                            FontAttributes="Bold" />

                        <Border Stroke="#775b46" StrokeShape="RoundRectangle 12" BackgroundColor="White">
                            <Entry x:Name="RecoveryEmailEntry"
                                Placeholder="seuemail@exemplo.com"
                                Keyboard="Email"
                                ReturnType="Done"
                                Completed="OnSendCodeClicked"
                                TextChanged="OnEmailChanged"
                                TextColor="#5C715E"
                                BackgroundColor="Transparent"
                                Margin="10,0,0,0"
                                HeightRequest="48" />
                        </Border>

                        <Label x:Name="EmailErrorLabel"
                            Text="Informe um e-mail válido"
                            FontSize="11"
                            TextColor="#C62828"
                            FontAttributes="Bold"
                            IsVisible="False" />
                    </VerticalStackLayout>

                    <Border x:Name="EmailGeneralErrorBorder"
                         IsVisible="False"
                         BackgroundColor="#FDECEA"
                         Stroke="#F5C2C0"
                         StrokeShape="RoundRectangle 10"
                         Padding="12,8">
                        <Label x:Name="EmailGeneralErrorLabel"
                            TextColor="#C62828"
                            FontSize="13" />
                    </Border>

                    <Button x:Name="SendCodeButton"
                         Text="Enviar código"
                         FontAttributes="Bold"
                         FontSize="16"
                         BackgroundColor="#2E7D32"
                         TextColor="White"
                         CornerRadius="12"
                         HeightRequest="52"
                         Clicked="OnSendCodeClicked"
                         Margin="0,16,0,0" />

                    <ActivityIndicator x:Name="EmailStepLoadingIndicator"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="#2E7D32" />
                </VerticalStackLayout>

                <!-- ETAPA 2: Informar código recebido -->
                <VerticalStackLayout x:Name="CodeStepLayout"
                                   Spacing="5"
                                   IsVisible="False">

                    <Label Text="Digite o código"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#2E7D32" />

                    <Label x:Name="CodeSentToLabel"
                        Text="Enviamos um código de 6 dígitos para o seu e-mail."
                        FontSize="12"
                        TextColor="#5C715E" />

                    <!-- 6 campos de OTP -->
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="5"  Margin="0,26,0,0">
                        <!-- Digito 1 -->
                        <Border Grid.Column="0" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="50" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit1"  MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E"/>
                        </Border>

                        <!-- Digito 2 -->
                        <Border Grid.Column="1" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="52" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit2" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E" />
                        </Border>

                        <!-- Digito 3 -->
                        <Border Grid.Column="2" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="52" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit3" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" VerticalOptions="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E"/>
                        </Border>

                        <!-- Digito 4 -->
                        <Border Grid.Column="3" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="52" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit4" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E"/>
                        </Border>

                        <!-- Digito 5 -->
                        <Border Grid.Column="4" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="52" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit5" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E"/>
                        </Border>

                        <!-- Digito 6 -->
                        <Border Grid.Column="5" Stroke="#775b46" StrokeThickness="1" StrokeShape="RoundRectangle 6" BackgroundColor="#EBF5EB" HeightRequest="52" HorizontalOptions="Fill">
                            <Entry x:Name="OtpDigit6" MaxLength="1" Keyboard="Numeric" HorizontalTextAlignment="Center" FontSize="20" TextChanged="OnOtpDigitChanged" TextColor="#5C715E"/>
                        </Border>
                    </Grid>


                    <Label x:Name="CodeErrorLabel"
                            Text="Código incorreto. Verifique e tente novamente."
                            FontSize="12"
                            TextColor="#C62828"
                            HorizontalOptions="Center"
                            IsVisible="False" />

                    <!-- Reenviar código -->
                    <HorizontalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Label Text="Não recebeu o código?"
                            FontSize="13"
                            TextColor="#5C715E" />

                        <Label x:Name="ResendCodeLabel"
                            Text="Reenviar"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="#2E7D32">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnResendCodeTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Button x:Name="ValidateCodeButton"
                         Text="Validar código"
                         FontAttributes="Bold"
                         FontSize="16"
                         BackgroundColor="#CCCCCC"
                         TextColor="White"
                         CornerRadius="12"
                         HeightRequest="52"
                         IsEnabled="False"
                         Clicked="OnValidateCodeClicked"
                         Margin="0,16,0,0" />

                    <ActivityIndicator x:Name="CodeStepLoadingIndicator"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="#2E7D32" />
                </VerticalStackLayout>

                <!-- ETAPA 3: Nova senha -->
                <VerticalStackLayout x:Name="NewPasswordStepLayout"
                                   Spacing="5"
                                   IsVisible="False">

                    <Label Text="Crie sua nova senha"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#2E7D32" />

                    <Label Text="Use pelo menos 6 caracteres. Recomendamos misturar letras e números."
                        FontSize="14"
                        TextColor="#5C715E" />

                    <VerticalStackLayout Spacing="4" Margin="0,16,0,0">
                        <Label Text="Nova senha"
                            FontSize="13"
                            TextColor="#775b46"
                            FontAttributes="Bold" />

                        <Border Stroke="#775b46"
                             StrokeShape="RoundRectangle 12"
                             BackgroundColor="White">
                            <Entry x:Name="NewPasswordEntry"
                                Placeholder="Nova senha"
                                IsPassword="True"
                                ReturnType="Next"
                                TextChanged="OnNewPasswordFieldsChanged"
                                BackgroundColor="Transparent"
                                Margin="12,0"
                                TextColor="#5C715E"
                                HeightRequest="48" />
                        </Border>

                        <Label x:Name="NewPasswordErrorLabel"
                            Text="A senha deve ter pelo menos 6 caracteres"
                            FontSize="12"
                            TextColor="#C62828"
                            IsVisible="False" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Confirmar nova senha"
                            FontSize="13"
                            TextColor="#775b46"
                            FontAttributes="Bold" />

                        <Border Stroke="#775b46"
                             StrokeShape="RoundRectangle 12"
                             BackgroundColor="White">
                            <Entry x:Name="ConfirmPasswordEntry"
                                Placeholder="Repita a nova senha"
                                IsPassword="True"
                                ReturnType="Done"
                                TextChanged="OnNewPasswordFieldsChanged"
                                Completed="OnResetPasswordClicked"
                                BackgroundColor="Transparent"
                                Margin="12,0"
                                TextColor="#5C715E"
                                HeightRequest="48" />
                        </Border>

                        <Label x:Name="ConfirmPasswordErrorLabel"
                            Text="As senhas não coincidem"
                            FontSize="12"
                            TextColor="#C62828"
                            IsVisible="False" />
                    </VerticalStackLayout>

                    <Border x:Name="ResetGeneralErrorBorder"
                         IsVisible="False"
                         BackgroundColor="#FDECEA"
                         Stroke="#F5C2C0"
                         StrokeShape="RoundRectangle 10"
                         Padding="12,8">
                        <Label x:Name="ResetGeneralErrorLabel"
                            TextColor="#C62828"
                            FontSize="13" />
                    </Border>

                    <Button x:Name="ResetPasswordButton"
                         Text="Redefinir senha"
                         FontAttributes="Bold"
                         FontSize="16"
                         BackgroundColor="#2E7D32"
                         TextColor="White"
                         CornerRadius="12"
                         HeightRequest="52"
                         Clicked="OnResetPasswordClicked"
                         Margin="0,16,0,0" />

                    <ActivityIndicator x:Name="NewPasswordStepLoadingIndicator"
                                     IsRunning="False"
                                     IsVisible="False"
                                     Color="#2E7D32" />
                </VerticalStackLayout>

                <!-- ETAPA 4 (sucesso): Confirmação -->
                <VerticalStackLayout x:Name="SuccessStepLayout"
                                     
                                   Spacing="16"
                                   IsVisible="False"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center">
                    <Grid>
                        <Image Source="sprout.png"
                                HeightRequest="100"
                                WidthRequest="100"
                                Aspect="AspectFit" />
                    </Grid>

                    <Label Text="Senha redefinida!"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#2E7D32"
                        HorizontalOptions="Center" />

                    <Label Text="Sua senha foi alterada com sucesso. Você já pode fazer login."
                        FontSize="14"
                        TextColor="#5C715E"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />

                    <Button Text="Ir para o Login"
                         FontAttributes="Bold"
                         FontSize="16"
                         BackgroundColor="#2E7D32"
                         TextColor="White"
                         CornerRadius="12"
                         HeightRequest="52"
                         WidthRequest="220"
                         Clicked="OnGoToLoginClicked"
                         Margin="0,16,0,0" />
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

    </Grid>
</ContentPage>