<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KaaDebug.Views.Profile.ProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F7F4"
             Title="ProfilePage">
    <Grid RowDefinitions="Auto, *">

        <!-- Barra superior -->
        <Grid Grid.Row="0"
          ColumnDefinitions="Auto, *, Auto"
          Padding="20,24,20,8">

            <ImageButton Grid.Column="0"
                     Source="go_back.png"
                     BackgroundColor="Transparent"
                     WidthRequest="40"
                     HeightRequest="40"
                     Clicked="OnBackClicked"
                     SemanticProperties.Description="Voltar" />

            <Label Grid.Column="1"
                   Text="Perfil"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#2E7D32"
                   HorizontalOptions="Center"
                   VerticalOptions="Center" />

            <BoxView Grid.Column="2"
                     WidthRequest="40"
                     Opacity="0">
            </BoxView>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,24" Spacing="24">

                <!-- Estado: carregando -->
                <VerticalStackLayout x:Name="LoadingStateLayout"
                                  Spacing="12" HorizontalOptions="Center"
                                  IsVisible="True" HeightRequest="300">
                    <ActivityIndicator IsRunning="True" Color="#2E7D32" HeightRequest="36" WidthRequest="36" />
                    <Label Text="Carregando perfil..." FontSize="14" TextColor="#5C715E" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Conteúdo -->
                <VerticalStackLayout x:Name="ContentLayout"
                                  Spacing="024"
                                  IsVisible="False">

                    <!-- Avatar + nome + e-mail -->
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">

                        <Border BackgroundColor="#A5D6A7"
                            StrokeThickness="2"
                            Stroke="#775b46"
                            StrokeShape="RoundRectangle 40"
                            WidthRequest="80"
                            HeightRequest="80"
                            HorizontalOptions="Center">
                            <Label x:Name="AvatarInitialsLabel"
                               Text="M"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                        </Border>

                        <Label x:Name="ProfileNameLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#2E7D32"
                           HorizontalOptions="Center" />

                        <Label x:Name="ProfileEmailLabel"
                           FontSize="13"
                           TextColor="#8A9A8C"
                           HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Seção: dados pessoais -->
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Dados pessoais"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#2E7D32" />

                        <Border BackgroundColor="White" Stroke="#775b46" StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="14">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Nome completo" FontSize="12" TextColor="#2E4A30" />
                                    <Entry x:Name="NameEntry"
                                       FontSize="15"
                                       TextColor="#2E4A30"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnProfileFieldChanged" />
                                    <BoxView HeightRequest="1" Color="#E3EFE4" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="E-mail" FontSize="12" TextColor="#8A9A8C" />
                                    <Label x:Name="EmailReadOnlyLabel"
                                       FontSize="15"
                                       TextColor="#8A9A8C" />
                                    <Label Text="O e-mail não pode ser alterado." FontSize="11" TextColor="#B0BEB2" />
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Seção: notificações -->
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Notificações"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#2E7D32"/>

                        <Border BackgroundColor="White" Stroke="#775b46" StrokeShape="RoundRectangle 14" Padding="14">
                            <VerticalStackLayout Spacing="14">

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Receber notificações" FontSize="14" FontAttributes="Bold" TextColor="#2E4A30" />
                                        <Label Text="Alertas sobre suas plantas" FontSize="12" TextColor="#8A9A8C" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1"
                                        x:Name="NotificationsSwitch"
                                        OnColor="#A5D6A7"
                                        ThumbColor="#2E7D32"
                                        Toggled="OnNotificationsSwitchToggled" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#E3EFE4" />

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Apenas alertas críticos" FontSize="14" FontAttributes="Bold" TextColor="#2E4A30" />
                                        <Label Text="Ignora avisos de baixa prioridade" FontSize="12" TextColor="#8A9A8C" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="1"
                                        x:Name="CriticalOnlySwitch"
                                        OnColor="#A5D6A7"
                                        ThumbColor="#2E7D32"
                                        Toggled="OnProfileFieldChanged" />
                                </Grid>

                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Salvar alterações -->
                    <Button x:Name="SaveButton"
                            Text="Salvar alterações"
                            FontAttributes="Bold"
                            FontSize="16"
                            BackgroundColor="#2E7D32"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="52"
                            IsVisible="False"
                            Clicked="OnSaveTapped" />

                    <ActivityIndicator x:Name="SaveLoadingIndicator"
                                    IsRunning="False" IsVisible="False" Color="#2E7D32" />

                    <!-- Erro/sucesso geral -->
                    <Border x:Name="FeedbackBorder"
                            IsVisible="False"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,8">
                        <Label x:Name="FeedbackLabel" FontSize="13" />
                    </Border>

                    <!-- Seção: segurança -->
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Segurança"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#2E7D32"/>

                        <Border BackgroundColor="White" Stroke="#775b46" StrokeShape="RoundRectangle 14" Padding="0">

                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*, Auto"
                                      Padding="14"
                                      HeightRequest="52">
                                    <Label Grid.Column="0" Text="Alterar senha"
                                       FontSize="14" TextColor="#2E4A30" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="›"
                                       FontSize="18" TextColor="#8A9A8C" VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChangePasswordTapped" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Logout -->
                    <Button Text="Sair da conta"
                            FontAttributes="Bold"
                            FontSize="15"
                            BackgroundColor="Transparent"
                            TextColor="#C62828"
                            BorderColor="#F5C2C0"
                            BorderWidth="1.5"
                            CornerRadius="12"
                            HeightRequest="48"
                            Clicked="OnLogoutClicked"
                            Margin="0,8,0,0" />

                    <!-- Versão -->
                    <Label Text="Budflow v1.0.0"
                           FontSize="11"
                           TextColor="#B0BEB2"
                           HorizontalOptions="Center"
                           Margin="0,8,0,0" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>